# ---------------------------------------------------------------
# Unity 项目专用 .gitignore
# 核心原则：Library/ 是可再生缓存（本项目约 3.1 GB），绝不提交
# ---------------------------------------------------------------

# Unity 生成的目录
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity 崩溃报告
sysinfo.txt
crashlytics-build.properties

# 自动生成的工程文件（由 Unity 依据 manifest.json 重新生成）
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Visual Studio / Rider / VS Code
/.vs/
/.idea/
/.vscode/
.vsconfig

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# 操作系统垃圾文件
.DS_Store
Thumbs.db
desktop.ini

# Unity 打包时生成的资源清单
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# ---------------------------------------------------------------
# Addressables 构建产物（每次构建自动重新生成，不入库）
# ---------------------------------------------------------------
# link.xml：Addressables 构建时自动生成的类型保留清单
/[Aa]ssets/AddressableAssetsData/link.xml
/[Aa]ssets/AddressableAssetsData/link.xml.meta

# 每个构建目标一个目录，存放增量构建用的内容状态
# 目前只有 Windows；以后新增平台（Android/、iOS/ 等）照此再加一行
/[Aa]ssets/AddressableAssetsData/Windows/
/[Aa]ssets/AddressableAssetsData/Windows.meta
